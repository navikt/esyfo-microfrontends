---
import { Heading } from "@navikt/ds-react";
import styles from "./MainContentText.module.css";

export interface Props {
    size: "small" | "medium" | "large" | "xsmall" | "xlarge";
    level: "1" | "2" | "3" | "4" | "5" | "6" | undefined;
}
---

<Heading className={styles.maintContentText} size={Astro.props.size} level={Astro.props.level}>
    <slot />
</Heading>