---
import styles from "./HeadingSpacing.module.css";
import { Heading } from "@navikt/ds-react";

export interface Props {
    size: "small" | "medium" | "large" | "xsmall" | "xlarge";
    level: "1" | "2" | "3" | "4" | "5" | "6" | undefined;
    className: string;
}

---

<Heading className={`${styles.headingRow} ${Astro.props.className}`} size={Astro.props.size} level={Astro.props.level}>
    <slot />
</Heading>