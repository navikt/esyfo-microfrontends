---
import { Tag } from "@navikt/ds-react";
import styles from "./ContainedTag.module.css";

export interface Props {
    size: "small" | "medium" | "xsmall" | undefined;
    variant: | "warning"
        | "warning-filled"
        | "warning-moderate"
        | "error"
        | "error-filled"
        | "error-moderate"
        | "info"
        | "info-filled"
        | "info-moderate"
        | "success"
        | "success-filled"
        | "success-moderate"
        | "neutral"
        | "neutral-filled"
        | "neutral-moderate"
        | "alt1"
        | "alt1-filled"
        | "alt1-moderate"
        | "alt2"
        | "alt2-filled"
        | "alt2-moderate"
        | "alt3"
        | "alt3-filled"
        | "alt3-moderate";
}
---

<Tag className={styles.containedTag} size={Astro.props.size} variant={Astro.props.variant}>
    <slot />
</Tag>