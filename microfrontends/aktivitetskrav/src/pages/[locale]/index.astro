---
import { MainPanel } from "@esyfo/shared/components";
import { isLocal } from "@esyfo/shared/environment";
import type { AktivitetskravVurdering } from "@schema/aktivitetskravVurderingSchema";
import { resolvePanel } from "@src/domain/panelResolver";
import { fetchAktivitetskravVurdering } from "@src/infrastructure/fetch";

const userToken = Astro.locals.token;

let aktivitetskravVurdering: AktivitetskravVurdering;
try {
  aktivitetskravVurdering = await fetchAktivitetskravVurdering(userToken);
} catch {
  return new Response("Internal Server Error", { status: 503 });
}

const panelProps = resolvePanel(aktivitetskravVurdering);
---

 {isLocal && <meta charset="UTF-8" />}
 {() => {
  return (
    <div>
      <MainPanel {...panelProps} />
    </div>
  );
}}
