---
import MikrofrontendLinkPanel from "@src/components/common/MikrofrontendLinkPanel.astro";
import { harVurdertHeadingText } from "@src/language/text";
import { getShortDateFormat } from "@src/utils/dateUtils";

interface Props {
  sistVurdert: string;
}
---

<MikrofrontendLinkPanel
  headingText={harVurdertHeadingText}
  bodyText="NAV vurderer at aktivitetsplikten ikke er aktuell for deg"
  alertStyle="info"
    tag={{
    variant: "info-moderate",
    text: `Dato for vurdering: ${getShortDateFormat(Astro.props.sistVurdert)}`
    }}
/>