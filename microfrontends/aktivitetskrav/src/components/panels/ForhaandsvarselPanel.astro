---
import { getShortDateFormat } from "@src/utils/dateUtils";
import { vurdererHeadingText } from "@src/language/text";
import UnderArbeidPanel from "@src/components/panels/UnderArbeidPanel.astro";
import MikrofrontendLinkPanel from "@src/components/common/MikrofrontendLinkPanel.astro";
import { TagMeta } from "@src/utils/types";

interface Props {
  journalpostId?: string;
  fristDato: string;
}

const { journalpostId, fristDato } = Astro.props;

const tagInfo: TagMeta | undefined = fristDato
    ? {
        variant: new Date() > new Date(fristDato) ? "error-moderate" : "warning-moderate",
        text: `Svarfrist: ${getShortDateFormat(fristDato)}`,
      }
    : undefined;

// if (!journalpostId) -> Vi har ikke mottatt all info fra isyfo enda, så viser mellomtilstand.
---

{() => {
    if (!journalpostId) {
        return <UnderArbeidPanel />;
    } else {
        return (
          <MikrofrontendLinkPanel
            headingText={vurdererHeadingText}
            bodyText="NAV vurderer å stanse sykepengene dine"
            alertStyle="warning"
            tag={tagInfo}
          />
        )
    }
}}
