---
import { DIALOGMOTE_URL } from "astro:env/server";
import { MainPanel } from "@esyfo/shared/components";
import { isLocal } from "@esyfo/shared/environment";
import type { BrevDto } from "@schema/brevSchema";
import { getLatestBrev, shouldShowDialogmotePanel } from "@src/domain/brev";
import { resolvePanel } from "@src/domain/panelResolver";
import { fetchBrev } from "@src/infrastructure/fetch";

const userToken = Astro.locals.token;

let brev: BrevDto[];

try {
  brev = await fetchBrev(userToken);
} catch {
  return new Response("Internal Server Error", { status: 503 });
}

const latestBrev = getLatestBrev(brev);
const showDialogmotePanel = shouldShowDialogmotePanel(latestBrev);
---

{isLocal && <meta charset="UTF-8" />}
{() => {
  if (showDialogmotePanel && latestBrev) {
    const panelProps = resolvePanel(latestBrev, DIALOGMOTE_URL);
    return (
      <div class="dialogmote-microfrontend">
        <MainPanel {...panelProps} />
      </div>
    );
  }
}}
