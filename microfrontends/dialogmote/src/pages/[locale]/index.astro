---
import { isLocal } from "@esyfo/shared/environment";
import type { BrevDTO } from "@schema/brevSchema";
import DialogmotePanel from "@src/components/moteinkalling/DialogmotePanel.astro";
import { getLatestBrev, getShowDialogmotePanel } from "@src/utils/brev";
import { fetchBrev } from "@src/utils/fetch";
import "@src/styles/aksel.css";

const userToken = Astro.locals.token;

let brev: BrevDTO[];

try {
  brev = await fetchBrev(userToken);
} catch {
  return new Response("Internal Server Error", { status: 503 });
}

const latestBrev = getLatestBrev(brev);
const showDialogmotePanel = getShowDialogmotePanel(latestBrev);
---

{isLocal && <meta charset="UTF-8" />}
{() => {
  if (showDialogmotePanel && latestBrev) {
    return (
      <DialogmotePanel attending={latestBrev.svar?.svarType || null} date={latestBrev.tid} brevType={latestBrev.brevType} />
    );
  }
}}
