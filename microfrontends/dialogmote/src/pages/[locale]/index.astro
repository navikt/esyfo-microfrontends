---
import { DIALOGMOTE_URL } from "astro:env/server";
import { MainPanel } from "@esyfo/shared/components";
import { isLocal } from "@esyfo/shared/environment";
import { logger } from "@navikt/pino-logger";
import type { BrevDto } from "@schema/brevSchema";
import type { MotebehovStatusDto } from "@schema/motebehovSchema";
import { getLatestBrev } from "@src/domain/brev";
import { resolveCombinedPanel } from "@src/domain/combinedPanelResolver";
import { fetchBrev, fetchMotebehov } from "@src/infrastructure/fetch";

const userToken = Astro.locals.token;

let brev: BrevDto[];
let motebehov: MotebehovStatusDto | null = null;

const [brevResult, motebehovResult] = await Promise.allSettled([
  fetchBrev(userToken),
  fetchMotebehov(userToken),
]);

if (brevResult.status === "rejected") {
  return new Response("Internal Server Error", { status: 503 });
}

brev = brevResult.value;

if (motebehovResult.status === "fulfilled") {
  motebehov = motebehovResult.value;
} else {
  logger.warn(
    { error: motebehovResult.reason },
    "Failed to fetch motebehov, continuing with dialogmote only",
  );
}

const latestBrev = getLatestBrev(brev);
const panel = resolveCombinedPanel(latestBrev, motebehov, DIALOGMOTE_URL);
---

{isLocal && <meta charset="UTF-8" />}
<!-- Wrapping div is necessary to load CSS for MainPanel. This is how Astro handles CSS loading. -->
{panel && (
  <div class="dialogmote-microfrontend">
    <MainPanel {...panel} />
  </div>
)}
