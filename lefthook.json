{
  "pre-commit": {
    "commands": {
      "check": {
        "glob": "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro}",
        "run": "pnpm exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --colors=off {staged_files}",
        "stage_fixed": true
      }
    }
  },
  "pre-push": {
    "commands": {
      "typecheck-dialogmote": {
        "run": "pnpm --filter dialogmote-microfrontend run typecheck"
      },
      "typecheck-aktivitetskrav": {
        "run": "pnpm --filter aktivitetskrav-microfrontend run typecheck"
      },
      "typecheck-motebehov": {
        "run": "pnpm --filter motebehov-microfrontend run typecheck"
      },
      "typecheck-shared": {
        "run": "pnpm --filter @esyfo/shared run typecheck"
      }
    }
  },
  "commit-msg": {
    "commands": {
      "no-empty-commit": {
        "run": "git diff --cached --quiet || exit 0; echo \"Nothing staged to commit. Empty commits are blocked to keep history clean.\"; exit 1"
      }
    }
  }
}
