{
  "pre-commit": {
    "commands": {
      "check": {
        "glob": "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro}",
        "run": "npx @biomejs/biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true --colors=off {staged_files}",
        "stage_fixed": true
      }
    }
  },
  "pre-push": {
    "commands": {
      "typecheck-dialogmote": {
        "run": "npm run build --workspace=microfrontends/dialogmote"
      },
      "typecheck-aktivitetskrav": {
        "run": "npm run build --workspace=microfrontends/aktivitetskrav"
      }
    }
  },
  "commit-msg": {
    "commands": {
      "no-empty-commit": {
        "run": "git diff --cached --quiet || exit 0; echo \"Nothing staged to commit. Empty commits are blocked to keep history clean.\"; exit 1"
      }
    }
  }
}
