{
  "name": "esyfo-microfrontends",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run build",
    "build:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run build",
    "build:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run build",
    "build:motebehov-microfrontend": "pnpm --filter motebehov-microfrontend run build",
    "dev:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run dev",
    "dev:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run dev",
    "dev:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run dev",
    "dev:motebehov-microfrontend": "pnpm --filter motebehov-microfrontend run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/node": "10.0.2",
    "@astrojs/react": "5.0.1",
    "@navikt/aksel-icons": "8.7.0",
    "@navikt/ds-css": "8.7.0",
    "@navikt/ds-react": "8.7.0",
    "@navikt/nav-dekoratoren-moduler": "3.6.3",
    "@navikt/oasis": "4.1.4",
    "@navikt/pino-logger": "4.5.1",
    "astro": "6.0.5",
    "pino": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@biomejs/biome": "2.4.7",
    "@storybook/react": "10.3.2",
    "@storybook/react-vite": "10.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "lefthook": "2.1.4",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.8",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.3.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.0"
  }
}
