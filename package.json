{
  "name": "esyfo-microfrontends",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run build",
    "build:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run build",
    "build:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run build",
    "dev:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run dev",
    "dev:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run dev",
    "dev:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@navikt/oasis": "4.2.2",
    "@navikt/pino-logger": "5.0.1",
    "astro": "7.3.2",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.13",
    "@opentelemetry/api": "1.9.1",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.1.14",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.28",
    "postcss-prefix-selector": "2.2.1",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
