{
  "name": "esyfo-microfrontends",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run build",
    "build:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run build",
    "build:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run build",
    "dev:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run dev",
    "dev:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run dev",
    "dev:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run dev"
  },
  "dependencies": {
    "@astrojs/node": "10.0.2",
    "@astrojs/react": "5.0.0",
    "@navikt/aksel-icons": "6.1.1",
    "@navikt/ds-css": "6.16.2",
    "@navikt/ds-react": "6.16.2",
    "@navikt/nav-dekoratoren-moduler": "3.6.3",
    "@navikt/oasis": "4.1.4",
    "@opentelemetry/sdk-node": "0.213.0",
    "astro": "6.0.5",
    "pino": "10.3.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@biomejs/biome": "2.4.7",
    "@hono/node-server": "1.19.11",
    "@types/node": "25.5.0",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.21",
    "concurrently": "9.2.1",
    "hono": "4.12.8",
    "lefthook": "2.1.4",
    "postcss": "8.5.8",
    "postcss-prefix-selector": "2.1.1",
    "rollup-plugin-import-map": "3.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
