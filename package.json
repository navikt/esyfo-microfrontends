{
  "name": "esyfo-microfrontends",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run build",
    "build:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run build",
    "build:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run build",
    "dev:dialogmote-microfrontend": "pnpm --filter dialogmote-microfrontend run dev",
    "dev:aktivitetskrav-microfrontend": "pnpm --filter aktivitetskrav-microfrontend run dev",
    "dev:meroppfolging-microfrontend": "pnpm --filter meroppfolging-microfrontend run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@astrojs/react": "5.0.5",
    "@navikt/aksel-icons": "8.10.6",
    "@navikt/ds-css": "8.10.6",
    "@navikt/ds-react": "8.10.6",
    "@navikt/nav-dekoratoren-moduler": "4.2.1",
    "@navikt/oasis": "4.1.4",
    "@navikt/pino-logger": "5.0.0",
    "astro": "6.3.7",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.4.15",
    "@storybook/react": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "lefthook": "2.1.8",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.15",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.4.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
